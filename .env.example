# Copy this file to .env and replace the placeholder values.
# Generate a secret key with: openssl rand -hex 32

# Backend
DATABASE_URL=postgresql+asyncpg://tracker:change-me@localhost:5432/tracker
SECRET_KEY=change-me
ENVIRONMENT=local

# Postgres container (must match the credentials in DATABASE_URL)
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracker